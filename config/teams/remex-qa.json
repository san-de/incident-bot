    "orgs": [
      "wkda"
    ],
    "cloneDepth": 200,
    "localRepoRoots": [],
    "lookbackHours": 48
  },
  "services": {
    "file": "config/services.json",
    "overlay": "services.local.json"
  },
  "poll": {
    "cron": "0 * * * *",
    "sinceFallbackMinutes": 75,
    "firstRunLookbackHours": 1,
    "searchLagMinutes": 10,
    "maxPerRun": 5,
    "timeBudgetMinutes": 45
  },
  "skip": {
    "olderThanHours": 48,
    "nonAlertMentions": true,
    "alertCodes": []
  },
  "knownNoise": [],
  "jira": {
    "enabled": true,
    "siteUrl": "https://wkdauto.atlassian.net",
    "project": "REMEX",
    "epic": {
